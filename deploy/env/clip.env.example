# /etc/apps/clip.env for the web container. root:root, mode 600.
# Generate secrets with: openssl rand -hex 32

DATABASE_URL=mysql://cap:REPLACE_WITH_DB_PASSWORD@mysql:3306/cap
WEB_URL=https://clip.sparkosol.co
NEXTAUTH_URL=https://clip.sparkosol.co
NEXTAUTH_SECRET=
DATABASE_ENCRYPTION_KEY=

MEDIA_SERVER_URL=http://media-server:3456
MEDIA_SERVER_WEBHOOK_URL=http://web:3000
MEDIA_SERVER_WEBHOOK_SECRET=

# Cloudflare R2 (node deploy/r2/setup.mjs --write-env prints these)
CAP_AWS_ACCESS_KEY=
CAP_AWS_SECRET_KEY=
CAP_AWS_BUCKET=clip-videos
CAP_AWS_REGION=auto
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_INTERNAL_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PATH_STYLE=true
S3_FORCE_PUT_UPLOADS=true

AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Company SSO
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_EMAIL_DOMAINS=sparkosol.com
OIDC_LINK_BY_EMAIL=false

CAP_VIDEOS_DEFAULT_PUBLIC=false
DESKTOP_UPDATES_BASE_URL=https://github.com/sparko-labs/clip/releases/latest/download
