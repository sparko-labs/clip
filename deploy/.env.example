# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

# Image location, printed by deploy/gcp/setup.sh
IMAGE_REGISTRY=europe-west1-docker.pkg.dev/PROJECT_ID/clip
IMAGE_TAG=latest

# Public HTTPS URLs behind your reverse proxy
WEB_URL=https://clip.sparkosol.co
S3_PUBLIC_URL=https://files.sparkosol.co

NEXTAUTH_SECRET=
DATABASE_ENCRYPTION_KEY=
MEDIA_SERVER_WEBHOOK_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# OIDC
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Company SSO
OIDC_ALLOWED_EMAIL_DOMAINS=sparkosol.com

# Optional
OIDC_LINK_BY_EMAIL=false
SCIM_BEARER_TOKEN=
CAP_VIDEOS_DEFAULT_PUBLIC=false
DESKTOP_UPDATES_BASE_URL=https://github.com/sparko-labs/clip/releases/latest/download
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
WEB_PORT=3000
MINIO_PORT=9000
